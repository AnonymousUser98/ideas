        <mxCell id="WJ9gDT0KFdKt9C58NnB0-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Wii starts from boot0 in ROM.&lt;div&gt;boot0 verifies boot1, detects unmodified boot1 and loads it.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="60" y="160" as="geometry" />
        </mxCell>
        <mxCell id="WJ9gDT0KFdKt9C58NnB0-8" edge="1" parent="1" source="WJ9gDT0KFdKt9C58NnB0-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="WJ9gDT0KFdKt9C58NnB0-7">
